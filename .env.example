# Railway sets PORT automatically; do not hard-code it in production.
NODE_ENV=production
CORS_ORIGINS=https://ureyimsen.com,https://www.ureyimsen.com
DATABASE_URL=
# Optional TURN server for WebRTC: use your own TURN credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
DB_FILE=./data/db.json

# Unique persistent namespace for this web app (keeps it separate from older deployments)
APP_NAMESPACE=ureyimsen-web-v26

# Never enable on a production deployment.
ALLOW_DEV_RECHARGE=false

# Optional self-hosted LiveKit SFU
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
